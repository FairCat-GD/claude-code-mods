      "frames": [
        {
          "body": "bob",
          "eyes": "closed",
          "extra": "extras/zzz.png"
        }
      ]
    },
    "stopped": {
      "frames": [
        {
          "body": "none",
          "extra": "extras/alert.png",
          "marks": {
            "#26262e": [[11, 16], [12, 16], [19, 16], [20, 16], [15, 22], [16, 22]]
          }
        }
      ],
      "note": "marks are raised brows and an open mouth"
    },
    "failed": {
      "frames": [
        {
          "body": "flip-vertical rows 3..29, then down 2",
          "eyes": "closed",
          "marks": "tongue: 3 red pixels and 1 dark red beside the nose; see playing_dead() in the script"
        }
      ]
    }
  },
