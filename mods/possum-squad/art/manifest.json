      "frames": [
        {
          "body": "none",
          "propDy": 0
        },
        {
          "body": "bob",
          "propDy": "propWorkDy"
        }
      ],
      "note": "the bob moves outfit with body; the prop layer moves by its own offset"
    },
    "planned": {
      "frames": [
        {
          "body": "none"
        }
      ],
      "colour": "greyed: 70% luminance grey, 30% colour, then 45% toward the background"
    },
    "needs-you": {
