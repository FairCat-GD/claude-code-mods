{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!docs", "!**/docs", "!**/.claude-plugin/types", "!package-lock.json"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "linter": { "enabled": true },
  "javascript": {
    "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "double", "semicolons": "asNeeded", "arrowParentheses": "asNeeded" },
    "jsxRuntime": "transparent",
    "globals": ["h", "Fragment"]
  }
}
